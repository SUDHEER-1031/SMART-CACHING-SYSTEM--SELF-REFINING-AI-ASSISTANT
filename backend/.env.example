# Groq API Keys (Required for inference and evaluation)
api_request=gsk_your_groq_api_key_here
api_compare=gsk_your_groq_evaluator_api_key_here

# Optional: Firebase Service Account credentials path (defaults to firebase-credentials.json in backend)
# FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# Optional: Groq Models (defaults shown below)
# GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
# GROQ_EVALUATOR_MODEL=openai/gpt-oss-20b
